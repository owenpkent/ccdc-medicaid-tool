{
  "name": "coverage-compass-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "gen:rules": "node scripts/gen-rules.mjs",
    "gen:example-barcode": "vite-node scripts/gen-example-barcode.ts",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "predev": "npm run gen:rules && npm run vendor:ocr",
    "dev": "vite",
    "prebuild": "npm run gen:rules && npm run vendor:ocr",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run gen:rules && npm run vendor:ocr",
    "test": "vitest run",
    "pretest:watch": "npm run gen:rules && npm run vendor:ocr",
    "test:watch": "vitest",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.18",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "js-yaml": "^5.2.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
