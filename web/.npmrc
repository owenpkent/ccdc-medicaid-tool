# Fail the install when the running Node version is below what a dependency
# declares. npm treats "engines" as advisory by default, which is how jsdom 29
# (^20.19.0) and @testing-library/jest-dom 7 (>=22) both installed cleanly on
# Node 20 and printed a warning nobody reads. A wrong Node version should stop
# you at install, not surface later as a test that behaves differently.
engine-strict=true
